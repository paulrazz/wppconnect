PORT=4005
# Required outside development. Send as x-api-key or Bearer token.
WPPCONNECT_API_KEY=replace-with-a-long-random-secret
# Comma-separated dashboard origins. Empty means localhost only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only when intentionally delivering webhooks to private networks.
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_TIMEOUT_MS=10000
